{% comment %}
  Bestseller — editorial "object of the season" feature block.
  A full-bleed split-screen: photo on one side, editorial copy on the other.
  The product is chosen in Theme Editor; falls back to an empty state.
{%- endcomment -%}

{%- assign bs_product = all_products[section.settings.product] -%}
{%- assign bs_has_product = false -%}
{%- if bs_product and bs_product != empty -%}
  {%- assign bs_has_product = true -%}
{%- endif -%}

{%- assign bs_image   = section.settings.custom_image | default: bs_product.featured_image -%}
{%- assign bs_reverse = section.settings.reverse -%}

<section
  class="bs full-width{% if bs_reverse %} bs--reverse{% endif %}"
  aria-label="{{ section.settings.eyebrow | default: 'Bestseller' }}"
>

  {%- comment -%} ── MEDIA SIDE ────────────────────────────────── {%- endcomment -%}
  <figure class="bs__media">
    {% if bs_image %}
      {{ bs_image
        | image_url: width: 2000
        | image_tag:
          class: 'bs__img',
          loading: 'lazy',
          widths: '600, 900, 1200, 1600, 2000',
          sizes: '(max-width: 900px) 100vw, 55vw'
      }}
    {% else %}
      <div class="bs__img bs__img--placeholder"></div>
    {% endif %}

    {%- comment -%} subtle grain + vignette overlays {%- endcomment -%}
    <div class="bs__grain" aria-hidden="true"></div>
    <div class="bs__edge"  aria-hidden="true"></div>

    {%- comment -%} corner crosshair marker {%- endcomment -%}
    <svg class="bs__crosshair" viewBox="0 0 40 40" aria-hidden="true">
      <line x1="0"  y1="20" x2="16" y2="20" stroke="currentColor" stroke-width="0.8"/>
      <line x1="24" y1="20" x2="40" y2="20" stroke="currentColor" stroke-width="0.8"/>
      <line x1="20" y1="0"  x2="20" y2="16" stroke="currentColor" stroke-width="0.8"/>
      <line x1="20" y1="24" x2="20" y2="40" stroke="currentColor" stroke-width="0.8"/>
      <circle cx="20" cy="20" r="4" stroke="currentColor" stroke-width="0.8" fill="none"/>
    </svg>

    <figcaption class="bs__caption">
      {{ section.settings.caption | default: 'The object — this season' }}
    </figcaption>
  </figure>

  {%- comment -%} ── COPY SIDE ─────────────────────────────────── {%- endcomment -%}
  <div class="bs__body">

    <header class="bs__meta">
      <span class="bs__object-no">{{ section.settings.object_no | default: 'N°001' }}</span>
      <span class="bs__rule"   aria-hidden="true"></span>
      <span class="bs__eyebrow">{{ section.settings.eyebrow | default: 'Bestseller' }}</span>
    </header>

    {% if section.settings.vendor_label != blank %}
      <p class="bs__vendor">{{ section.settings.vendor_label }}</p>
    {% elsif bs_has_product and bs_product.vendor != blank %}
      <p class="bs__vendor">{{ bs_product.vendor | escape }}</p>
    {% endif %}

    <h2 class="bs__title">
      {%- if section.settings.custom_title != blank -%}
        {{ section.settings.custom_title }}
      {%- elsif bs_has_product -%}
        {{ bs_product.title | escape }}
      {%- else -%}
        {{ section.settings.fallback_title | default: 'Select a piece in Theme Editor' }}
      {%- endif -%}
    </h2>

    {% if bs_has_product %}
      <p class="bs__price">
        {% if bs_product.compare_at_price_max > bs_product.price %}
          <s class="bs__price-was">{{ bs_product.compare_at_price_max | money }}</s>
        {% endif %}
        <span class="bs__price-now">{{ bs_product.price | money }}</span>
      </p>
    {% endif %}

    <div class="bs__rule-wide" aria-hidden="true"></div>

    {% if section.settings.description != blank %}
      <div class="bs__desc">{{ section.settings.description }}</div>
    {% elsif bs_has_product and bs_product.description != blank %}
      <div class="bs__desc">
        {{ bs_product.description | strip_html | truncatewords: 38 }}
      </div>
    {% endif %}

    {%- comment -%} Stats line — 3 editorial tags {%- endcomment -%}
    {% if section.settings.tag_1 != blank
       or section.settings.tag_2 != blank
       or section.settings.tag_3 != blank %}
      <ul class="bs__tags">
        {% if section.settings.tag_1 != blank %}
          <li class="bs__tag">{{ section.settings.tag_1 }}</li>
        {% endif %}
        {% if section.settings.tag_2 != blank %}
          <li class="bs__tag">{{ section.settings.tag_2 }}</li>
        {% endif %}
        {% if section.settings.tag_3 != blank %}
          <li class="bs__tag">{{ section.settings.tag_3 }}</li>
        {% endif %}
      </ul>
    {% endif %}

    {%- comment -%} CTA ── product page if chosen, custom URL, or /collections {%- endcomment -%}
    {%- assign bs_cta_url = section.settings.cta_url -%}
    {%- if bs_cta_url == blank and bs_has_product -%}
      {%- assign bs_cta_url = bs_product.url -%}
    {%- endif -%}
    {%- if bs_cta_url == blank -%}
      {%- assign bs_cta_url = routes.collections_url -%}
    {%- endif -%}

    <a href="{{ bs_cta_url }}" class="bs__cta">
      <span class="bs__cta-label">
        {{ section.settings.cta_label | default: 'View the piece' }}
      </span>
      <span class="bs__cta-arrow" aria-hidden="true">→</span>
    </a>

  </div>
</section>

{% stylesheet %}
  /* ── Tokens ──────────────────────────────────────────────── */
  .bs {
    --bg:    #0a0a09;
    --cream: #e6e1d6;
    --muted: rgba(230, 225, 214, 0.42);
    --line:  rgba(230, 225, 214, 0.1);
    --serif: var(--font-heading--family, "Playfair Display", Georgia, serif);
    --sans:  var(--font-body--family,    "Work Sans", system-ui, sans-serif);
  }

  .bs {
    background: var(--bg) !important;
    color:      var(--cream);
    display:    grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: stretch;
    min-height:  clamp(520px, 80vh, 840px);
    border-top:    1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .bs--reverse { grid-template-columns: 1fr 1.15fr; }
  .bs--reverse .bs__media { order: 2; }
  .bs--reverse .bs__body  { order: 1; border-right: 1px solid var(--line); border-left: none; }

  /* ═══════════════════════════════════════════════════════
     MEDIA
  ═══════════════════════════════════════════════════════ */
  .bs__media {
    position:  relative;
    overflow:  hidden;
    margin:    0;
    min-height: 100%;
  }

  .bs__img {
    display:    block;
    width:      100%;
    height:     100%;
    object-fit: cover;
    filter:     saturate(0.72) contrast(1.06) brightness(0.95);
    transition: transform 1.1s cubic-bezier(0.23, 1, 0.32, 1),
                filter    0.6s ease;
  }

  .bs:hover .bs__img {
    transform: scale(1.028);
    filter:    saturate(0.9) contrast(1.02) brightness(1);
  }

  .bs__img--placeholder {
    background: linear-gradient(150deg, #1e1e1c 0%, #2c2c28 100%);
  }

  .bs__grain {
    position:         absolute;
    inset:            0;
    pointer-events:   none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3CfeColorMatrix type='saturate' values='0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    background-size:  200px;
    mix-blend-mode:   overlay;
    opacity:          0.6;
  }

  .bs__edge {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to top,    rgba(10,10,9,0.35) 0%, rgba(10,10,9,0) 35%),
      linear-gradient(to right,  rgba(10,10,9,0.25) 0%, rgba(10,10,9,0) 25%);
  }

  .bs__crosshair {
    position: absolute;
    top:     1.2rem;
    left:    1.2rem;
    width:   28px;
    height:  28px;
    color:   rgba(230, 225, 214, 0.6);
    pointer-events: none;
  }

  .bs__caption {
    position:       absolute;
    bottom:         1.2rem;
    right:          1.4rem;
    font-family:    var(--sans);
    font-size:      0.55rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color:          rgba(230, 225, 214, 0.55);
  }

  /* ═══════════════════════════════════════════════════════
     COPY BODY
  ═══════════════════════════════════════════════════════ */
  .bs__body {
    padding:         clamp(3rem, 7vw, 7rem) clamp(1.5rem, 5.5vw, 5.5rem);
    display:         flex;
    flex-direction:  column;
    justify-content: center;
    gap:             1.2rem;
    border-left:     1px solid var(--line);
  }

  .bs__meta {
    display:     flex;
    align-items: center;
    gap:         0.85rem;
    margin-bottom: 0.5rem;
  }

  .bs__object-no {
    font-family:    var(--serif);
    font-style:     italic;
    font-weight:    300;
    font-size:      1.25rem;
    color:          var(--cream);
    opacity:        0.5;
    line-height:    1;
  }

  .bs__rule {
    display:    inline-block;
    width:      3rem;
    height:     1px;
    background: rgba(230, 225, 214, 0.25);
  }

  .bs__eyebrow {
    font-family:    var(--sans);
    font-size:      0.55rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color:          var(--muted);
  }

  .bs__vendor {
    font-family:    var(--sans);
    font-size:      0.6rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color:          var(--muted);
    margin:         0 0 0.2rem;
  }

  .bs__title {
    font-family:    var(--serif);
    font-weight:    300;
    font-size:      clamp(2.4rem, 5.5vw, 5.6rem);
    line-height:    1;
    letter-spacing: -0.025em;
    color:          var(--cream);
    margin:         0;
  }

  .bs__price {
    font-family:    var(--serif);
    font-style:     italic;
    font-weight:    300;
    font-size:      clamp(1.2rem, 1.8vw, 1.55rem);
    color:          var(--cream);
    opacity:        0.78;
    margin:         0.6rem 0 0;
    display:        flex;
    align-items:    baseline;
    gap:            0.8rem;
  }

  .bs__price-was {
    opacity: 0.35;
    text-decoration: line-through;
    font-style: normal;
    font-size: 0.88em;
  }

  .bs__rule-wide {
    width:      100%;
    max-width:  28rem;
    height:     1px;
    background: var(--line);
    margin:     1rem 0 0.2rem;
  }

  .bs__desc {
    font-family: var(--sans);
    font-size:   clamp(0.84rem, 1vw, 0.95rem);
    line-height: 1.85;
    color:       var(--muted);
    max-width:   42ch;
    margin:      0;
  }

  .bs__desc p { margin: 0 0 0.9em; }
  .bs__desc p:last-child { margin-bottom: 0; }

  /* Editorial tags row */
  .bs__tags {
    list-style: none;
    padding:    0;
    margin:     0.6rem 0 0;
    display:    flex;
    flex-wrap:  wrap;
    gap:        1.2rem 2rem;
  }

  .bs__tag {
    font-family:    var(--sans);
    font-size:      0.55rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color:          var(--cream);
    opacity:        0.6;
    position:       relative;
    padding-left:   1rem;
  }

  .bs__tag::before {
    content:   '';
    position:  absolute;
    left:      0;
    top:       50%;
    width:     6px;
    height:    1px;
    background: rgba(230, 225, 214, 0.55);
  }

  /* CTA */
  .bs__cta {
    margin-top:      1.4rem;
    display:         inline-flex;
    align-items:     center;
    gap:             1.4rem;
    font-family:     var(--sans);
    font-size:       0.7rem;
    letter-spacing:  0.28em;
    text-transform:  uppercase;
    color:           var(--cream);
    text-decoration: none;
    padding:         0.8rem 0;
    width:           fit-content;
    border-bottom:   1px solid rgba(230, 225, 214, 0.3);
    transition:      border-color 260ms ease, color 260ms ease, gap 350ms ease;
  }

  .bs__cta-arrow {
    display: inline-block;
    transition: transform 420ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .bs__cta:hover {
    color:        #fff;
    border-color: var(--cream);
    gap:          2rem;
  }

  .bs__cta:hover .bs__cta-arrow { transform: translateX(4px); }

  /* ═══════════════════════════════════════════════════════
     RESPONSIVE
  ═══════════════════════════════════════════════════════ */
  @media (max-width: 900px) {
    .bs,
    .bs--reverse {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .bs--reverse .bs__media { order: 1; }
    .bs--reverse .bs__body  { order: 2; border-left: none; border-right: none; border-top: 1px solid var(--line); }
    .bs__body { border-left: none; border-top: 1px solid var(--line); }

    .bs__media { aspect-ratio: 4 / 5; min-height: 0; }
    .bs__body  { padding: clamp(3rem, 10vw, 5rem) clamp(1.2rem, 5vw, 3rem); }
  }

  @media (max-width: 640px) {
    .bs__title     { font-size: clamp(2.2rem, 10vw, 3.4rem); }
    .bs__crosshair { width: 22px; height: 22px; top: 0.9rem; left: 0.9rem; }
    .bs__caption   { font-size: 0.5rem; bottom: 0.9rem; right: 1rem; }
    .bs__tags      { gap: 0.7rem 1.4rem; }
  }

  /* ── prefers-reduced-motion ──────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .bs__img,
    .bs__cta,
    .bs__cta-arrow { transition: none !important; }
    .bs:hover .bs__img { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bestseller",
  "tag": "section",
  "class": "section-bestseller",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Bestseller product"
    },
    {
      "type": "image_picker",
      "id": "custom_image",
      "label": "Custom image (overrides product photo)"
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Bestseller"
    },
    {
      "type": "text",
      "id": "object_no",
      "label": "Object number",
      "default": "N°001"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Photo caption",
      "default": "The object — this season"
    },
    {
      "type": "text",
      "id": "vendor_label",
      "label": "Vendor / House label (optional)",
      "info": "Overrides product.vendor when set."
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "custom_title",
      "label": "Custom title (overrides product title)"
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Fallback title",
      "default": "Select a piece in Theme Editor"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description (overrides product description)",
      "default": "<p>Worn and re-worn. The silhouette chosen most this season — the piece our clients return to, layer after layer, wardrobe after wardrobe. Not a trend. A foundation.</p>"
    },
    {
      "type": "header",
      "content": "Editorial Tags"
    },
    {
      "type": "text",
      "id": "tag_1",
      "label": "Tag 1",
      "default": "Most worn"
    },
    {
      "type": "text",
      "id": "tag_2",
      "label": "Tag 2",
      "default": "Luxmaxx staple"
    },
    {
      "type": "text",
      "id": "tag_3",
      "label": "Tag 3",
      "default": "Season no. 26"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "View the piece"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link (optional, defaults to product URL)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Reverse layout (text left, photo right)",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Bestseller"
    }
  ]
}
{% endschema %}
