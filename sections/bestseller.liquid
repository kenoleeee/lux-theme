{% comment %}
  Bestseller — editorial "object of the season" feature block.
  A full-bleed split-screen: photo on one side, editorial copy on the other.
  The product is chosen in Theme Editor; falls back to an empty state.
{%- endcomment -%}

{%- assign bs_product = all_products[section.settings.product] -%}
{%- assign bs_has_product = false -%}
{%- if bs_product and bs_product != empty -%}
  {%- assign bs_has_product = true -%}
{%- endif -%}

{%- assign bs_image   = section.settings.custom_image | default: bs_product.featured_image -%}
{%- assign bs_reverse = section.settings.reverse -%}

<section
  class="bs full-width{% if bs_reverse %} bs--reverse{% endif %}"
  aria-label="{{ section.settings.eyebrow | default: 'Bestseller' }}"
>

  {%- comment -%} ── MEDIA SIDE ────────────────────────────────── {%- endcomment -%}
  <figure class="bs__media">
    {% if bs_image %}
      {{ bs_image
        | image_url: width: 2000
        | image_tag:
          class: 'bs__img',
          loading: 'lazy',
          widths: '600, 900, 1200, 1600, 2000',
          sizes: '(max-width: 900px) 100vw, 55vw'
      }}
    {% else %}
      <div class="bs__img bs__img--placeholder"></div>
    {% endif %}

    {%- comment -%} subtle grain + vignette overlays {%- endcomment -%}
    <div class="bs__grain" aria-hidden="true"></div>
    <div class="bs__edge"  aria-hidden="true"></div>

    {%- comment -%} corner crosshair marker {%- endcomment -%}
    <svg class="bs__crosshair" viewBox="0 0 40 40" aria-hidden="true">
      <line x1="0"  y1="20" x2="16" y2="20" stroke="currentColor" stroke-width="0.8"/>
      <line x1="24" y1="20" x2="40" y2="20" stroke="currentColor" stroke-width="0.8"/>
      <line x1="20" y1="0"  x2="20" y2="16" stroke="currentColor" stroke-width="0.8"/>
      <line x1="20" y1="24" x2="20" y2="40" stroke="currentColor" stroke-width="0.8"/>
      <circle cx="20" cy="20" r="4" stroke="currentColor" stroke-width="0.8" fill="none"/>
    </svg>

    <figcaption class="bs__caption">
      {{ section.settings.caption | default: 'The object — this season' }}
    </figcaption>
  </figure>

  {%- comment -%} ── COPY SIDE ─────────────────────────────────── {%- endcomment -%}
  <div class="bs__body">

    <header class="bs__meta">
      <span class="bs__object-no">{{ section.settings.object_no | default: 'N°001' }}</span>
      <span class="bs__rule"   aria-hidden="true"></span>
      <span class="bs__eyebrow">{{ section.settings.eyebrow | default: 'Bestseller' }}</span>
    </header>

    {% if section.settings.vendor_label != blank %}
      <p class="bs__vendor">{{ section.settings.vendor_label }}</p>
    {% elsif bs_has_product and bs_product.vendor != blank %}
      <p class="bs__vendor">{{ bs_product.vendor | escape }}</p>
    {% endif %}

    <h2 class="bs__title">
      {%- if section.settings.custom_title != blank -%}
        {{ section.settings.custom_title }}
      {%- elsif bs_has_product -%}
        {{ bs_product.title | escape }}
      {%- else -%}
        {{ section.settings.fallback_title | default: 'Select a piece in Theme Editor' }}
      {%- endif -%}
    </h2>

    {% if bs_has_product %}
      <p class="bs__price">
        {% if bs_product.compare_at_price_max > bs_product.price %}
          <s class="bs__price-was">{{ bs_product.compare_at_price_max | money }}</s>
        {% endif %}
        <span class="bs__price-now">{{ bs_product.price | money }}</span>
      </p>
    {% endif %}

    <div class="bs__rule-wide" aria-hidden="true"></div>

    {% if section.settings.description != blank %}
      <div class="bs__desc">{{ section.settings.description }}</div>
    {% elsif bs_has_product and bs_product.description != blank %}
      <div class="bs__desc">
        {{ bs_product.description | strip_html | truncatewords: 38 }}
      </div>
    {% endif %}

    {%- comment -%} ── BUNDLE CONTENTS LIST ───────────────────────────
         Blocks of type "bundle_item" rendered via product picker.
         Shown as an editorial "INCLUDED IN THIS BUNDLE" list.
    {%- endcomment -%}
    {% if section.blocks.size > 0 %}
      <div class="bs__bundle">
        <p class="bs__bundle-label">
          {{ section.settings.bundle_label | default: 'Included in this bundle' }}
        </p>
        <ul class="bs__bundle-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'bundle_item' -%}
              {%- assign bi_prod = all_products[block.settings.product] -%}
              {%- assign bi_title = block.settings.custom_title -%}
              {%- if bi_title == blank and bi_prod and bi_prod != empty -%}
                {%- assign bi_title = bi_prod.title -%}
              {%- endif -%}
              {%- if bi_title == blank -%}
                {%- assign bi_title = 'Unnamed item' -%}
              {%- endif -%}

              {%- if forloop.index < 10 -%}
                {%- assign bi_idx = '0' | append: forloop.index -%}
              {%- else -%}
                {%- assign bi_idx = forloop.index | append: '' -%}
              {%- endif -%}

              <li class="bs__bundle-item" {{ block.shopify_attributes }}>
                <span class="bs__bundle-no">{{ bi_idx }}</span>
                <span class="bs__bundle-name">{{ bi_title | escape }}</span>
                {% if bi_prod and bi_prod != empty %}
                  <span class="bs__bundle-price">{{ bi_prod.price | money }}</span>
                {% elsif block.settings.price_label != blank %}
                  <span class="bs__bundle-price">{{ block.settings.price_label }}</span>
                {% endif %}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {% endif %}

    {%- comment -%} ── ADD-TO-CART / CTA ─────────────────────────────── {%- endcomment -%}
    {%- if bs_has_product -%}
      {%- assign bs_variant = bs_product.selected_or_first_available_variant -%}
      {% form 'product', bs_product, class: 'pd__form pd__form--atc bs__form', id: 'bs-atc-form' %}
        <input type="hidden" name="id" value="{{ bs_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button
          type="submit"
          class="bs__cta pd__btn pd__btn--outline"
          data-atc-btn
          data-atc-label="{{ section.settings.cta_label | default: 'Add bundle to bag' }}"
          data-atc-adding="{{ 'product.adding' | t }}"
          data-atc-added="{{ 'product.added' | t }}"
          {% unless bs_variant.available %}disabled{% endunless %}
        >
          <span class="bs__cta-label pd__btn-text">
            {%- if bs_variant.available -%}
              {{ section.settings.cta_label | default: 'Add bundle to bag' }}
            {%- else -%}
              {{ 'product.sold_out' | t }}
            {%- endif -%}
          </span>
          <span class="bs__cta-arrow" aria-hidden="true">→</span>
        </button>
      {% endform %}

      {%- comment -%} Secondary text link to the product page {%- endcomment -%}
      <a href="{{ bs_product.url }}" class="bs__cta-secondary">
        {{ section.settings.secondary_cta_label | default: 'View full details' }}
      </a>
    {%- else -%}
      {%- comment -%} No product chosen — simple link fallback {%- endcomment -%}
      {%- assign bs_cta_url = section.settings.cta_url | default: routes.collections_url -%}
      <a href="{{ bs_cta_url }}" class="bs__cta bs__cta--link">
        <span class="bs__cta-label">
          {{ section.settings.cta_label | default: 'Select a bundle' }}
        </span>
        <span class="bs__cta-arrow" aria-hidden="true">→</span>
      </a>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
  /* ── Tokens ──────────────────────────────────────────────── */
  .bs {
    --bg:    #0a0a09;
    --cream: #e6e1d6;
    --muted: rgba(230, 225, 214, 0.42);
    --line:  rgba(230, 225, 214, 0.1);
    --serif: var(--font-heading--family, "Playfair Display", Georgia, serif);
    --sans:  var(--font-body--family,    "Work Sans", system-ui, sans-serif);
  }

  .bs {
    background: var(--bg) !important;
    color:      var(--cream);
    display:    grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: stretch;
    min-height:  clamp(520px, 80vh, 840px);
    border-top:    1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .bs--reverse { grid-template-columns: 1fr 1.15fr; }
  .bs--reverse .bs__media { order: 2; }
  .bs--reverse .bs__body  { order: 1; border-right: 1px solid var(--line); border-left: none; }

  /* ═══════════════════════════════════════════════════════
     MEDIA
  ═══════════════════════════════════════════════════════ */
  .bs__media {
    position:  relative;
    overflow:  hidden;
    margin:    0;
    min-height: 100%;
  }

  .bs__img {
    display:    block;
    width:      100%;
    height:     100%;
    object-fit: cover;
    filter:     saturate(0.72) contrast(1.06) brightness(0.95);
    transition: transform 1.1s cubic-bezier(0.23, 1, 0.32, 1),
                filter    0.6s ease;
  }

  .bs:hover .bs__img {
    transform: scale(1.028);
    filter:    saturate(0.9) contrast(1.02) brightness(1);
  }

  .bs__img--placeholder {
    background: linear-gradient(150deg, #1e1e1c 0%, #2c2c28 100%);
  }

  .bs__grain {
    position:         absolute;
    inset:            0;
    pointer-events:   none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3CfeColorMatrix type='saturate' values='0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    background-size:  200px;
    mix-blend-mode:   overlay;
    opacity:          0.6;
  }

  .bs__edge {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to top,    rgba(10,10,9,0.35) 0%, rgba(10,10,9,0) 35%),
      linear-gradient(to right,  rgba(10,10,9,0.25) 0%, rgba(10,10,9,0) 25%);
  }

  .bs__crosshair {
    position: absolute;
    top:     1.2rem;
    left:    1.2rem;
    width:   28px;
    height:  28px;
    color:   rgba(230, 225, 214, 0.6);
    pointer-events: none;
  }

  .bs__caption {
    position:       absolute;
    bottom:         1.2rem;
    right:          1.4rem;
    font-family:    var(--sans);
    font-size:      0.55rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color:          rgba(230, 225, 214, 0.55);
  }

  /* ═══════════════════════════════════════════════════════
     COPY BODY
  ═══════════════════════════════════════════════════════ */
  .bs__body {
    padding:         clamp(3rem, 7vw, 7rem) clamp(1.5rem, 5.5vw, 5.5rem);
    display:         flex;
    flex-direction:  column;
    justify-content: center;
    gap:             1.2rem;
    border-left:     1px solid var(--line);
  }

  .bs__meta {
    display:     flex;
    align-items: center;
    gap:         0.85rem;
    margin-bottom: 0.5rem;
  }

  .bs__object-no {
    font-family:    var(--serif);
    font-style:     italic;
    font-weight:    300;
    font-size:      1.25rem;
    color:          var(--cream);
    opacity:        0.5;
    line-height:    1;
  }

  .bs__rule {
    display:    inline-block;
    width:      3rem;
    height:     1px;
    background: rgba(230, 225, 214, 0.25);
  }

  .bs__eyebrow {
    font-family:    var(--sans);
    font-size:      0.55rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color:          var(--muted);
  }

  .bs__vendor {
    font-family:    var(--sans);
    font-size:      0.6rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color:          var(--muted);
    margin:         0 0 0.2rem;
  }

  .bs__title {
    font-family:    var(--serif);
    font-weight:    300;
    font-size:      clamp(2.4rem, 5.5vw, 5.6rem);
    line-height:    1;
    letter-spacing: -0.025em;
    color:          var(--cream);
    margin:         0;
  }

  .bs__price {
    font-family:    var(--serif);
    font-style:     italic;
    font-weight:    300;
    font-size:      clamp(1.2rem, 1.8vw, 1.55rem);
    color:          var(--cream);
    opacity:        0.78;
    margin:         0.6rem 0 0;
    display:        flex;
    align-items:    baseline;
    gap:            0.8rem;
  }

  .bs__price-was {
    opacity: 0.35;
    text-decoration: line-through;
    font-style: normal;
    font-size: 0.88em;
  }

  .bs__rule-wide {
    width:      100%;
    max-width:  28rem;
    height:     1px;
    background: var(--line);
    margin:     1rem 0 0.2rem;
  }

  .bs__desc {
    font-family: var(--sans);
    font-size:   clamp(0.84rem, 1vw, 0.95rem);
    line-height: 1.85;
    color:       var(--muted);
    max-width:   42ch;
    margin:      0;
  }

  .bs__desc p { margin: 0 0 0.9em; }
  .bs__desc p:last-child { margin-bottom: 0; }

  /* ═══════════════════════════════════════════════════════
     BUNDLE CONTENTS
  ═══════════════════════════════════════════════════════ */
  .bs__bundle {
    margin-top: 0.6rem;
  }

  .bs__bundle-label {
    font-family:    var(--sans);
    font-size:      0.55rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color:          var(--muted);
    margin:         0 0 0.85rem;
  }

  .bs__bundle-list {
    list-style: none;
    padding:    0;
    margin:     0;
    max-width:  32rem;
  }

  .bs__bundle-item {
    display:         grid;
    grid-template-columns: auto 1fr auto;
    align-items:     baseline;
    gap:             1rem;
    padding:         0.85rem 0;
    border-bottom:   1px solid var(--line);
  }

  .bs__bundle-item:last-child { border-bottom: none; }

  .bs__bundle-no {
    font-family:    var(--sans);
    font-size:      0.55rem;
    letter-spacing: 0.14em;
    color:          var(--cream);
    opacity:        0.38;
    font-variant-numeric: tabular-nums;
  }

  .bs__bundle-name {
    font-family:    var(--serif);
    font-style:     italic;
    font-weight:    300;
    font-size:      1rem;
    line-height:    1.3;
    color:          var(--cream);
  }

  .bs__bundle-price {
    font-family:    var(--sans);
    font-size:      0.62rem;
    letter-spacing: 0.16em;
    color:          var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* ═══════════════════════════════════════════════════════
     CTA — primary button + secondary link
  ═══════════════════════════════════════════════════════ */
  .bs__form {
    margin:  1.6rem 0 0;
    padding: 0;
  }

  .bs__cta {
    margin-top:      1.4rem;
    display:         inline-flex;
    align-items:     center;
    justify-content: space-between;
    gap:             2rem;
    font-family:     var(--sans);
    font-size:       0.7rem;
    letter-spacing:  0.28em;
    text-transform:  uppercase;
    color:           var(--cream);
    text-decoration: none;
    padding:         1.1rem 1.8rem;
    min-width:       18rem;
    width:           fit-content;
    background:      transparent;
    border:          1px solid var(--cream);
    border-radius:   0 !important;
    cursor:          pointer;
    transition:
      background   280ms ease,
      color        280ms ease,
      gap          320ms ease;
    position:        relative;
    overflow:        hidden;
  }

  .bs__form .bs__cta { margin-top: 0; }

  .bs__cta-label {
    display:   inline-block;
    flex:      1 1 auto;
    text-align: left;
  }

  .bs__cta-arrow {
    display: inline-block;
    transition: transform 420ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .bs__cta:hover:not([disabled]) {
    background: var(--cream);
    color:      #0a0a09;
    gap:        2.4rem;
  }

  .bs__cta:hover:not([disabled]) .bs__cta-arrow { transform: translateX(4px); }

  .bs__cta[disabled] {
    opacity: 0.4;
    cursor:  not-allowed;
  }

  /* When used as plain link (no product chosen) */
  .bs__cta--link {
    border: none;
    padding: 0.8rem 0;
    min-width: 0;
    border-bottom: 1px solid rgba(230, 225, 214, 0.3);
  }

  .bs__cta--link:hover { background: transparent; color: #fff; }

  /* Secondary link below the main CTA */
  .bs__cta-secondary {
    display:         inline-block;
    margin-top:      1rem;
    font-family:     var(--sans);
    font-size:       0.58rem;
    letter-spacing:  0.24em;
    text-transform:  uppercase;
    color:           var(--muted);
    text-decoration: none;
    border-bottom:   1px solid transparent;
    padding-bottom:  2px;
    transition:      color 220ms ease, border-color 220ms ease;
  }

  .bs__cta-secondary:hover {
    color:        var(--cream);
    border-color: rgba(230, 225, 214, 0.35);
  }

  /* ═══════════════════════════════════════════════════════
     RESPONSIVE
  ═══════════════════════════════════════════════════════ */
  @media (max-width: 900px) {
    .bs,
    .bs--reverse {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .bs--reverse .bs__media { order: 1; }
    .bs--reverse .bs__body  { order: 2; border-left: none; border-right: none; border-top: 1px solid var(--line); }
    .bs__body { border-left: none; border-top: 1px solid var(--line); }

    .bs__media { aspect-ratio: 4 / 5; min-height: 0; }
    .bs__body  { padding: clamp(3rem, 10vw, 5rem) clamp(1.2rem, 5vw, 3rem); }
  }

  @media (max-width: 640px) {
    .bs__title        { font-size: clamp(2.2rem, 10vw, 3.4rem); }
    .bs__crosshair    { width: 22px; height: 22px; top: 0.9rem; left: 0.9rem; }
    .bs__caption      { font-size: 0.5rem; bottom: 0.9rem; right: 1rem; }
    .bs__cta          { min-width: 0; width: 100%; padding: 1rem 1.3rem; font-size: 0.62rem; }
    .bs__bundle-name  { font-size: 0.95rem; }
    .bs__bundle-item  { gap: 0.8rem; }
  }

  /* ── prefers-reduced-motion ──────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .bs__img,
    .bs__cta,
    .bs__cta-arrow { transition: none !important; }
    .bs:hover .bs__img { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bestseller",
  "tag": "section",
  "class": "section-bestseller",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Bestseller product"
    },
    {
      "type": "image_picker",
      "id": "custom_image",
      "label": "Custom image (overrides product photo)"
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Bestseller"
    },
    {
      "type": "text",
      "id": "object_no",
      "label": "Object number",
      "default": "N°001"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Photo caption",
      "default": "The object — this season"
    },
    {
      "type": "text",
      "id": "vendor_label",
      "label": "Vendor / House label (optional)",
      "info": "Overrides product.vendor when set."
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "custom_title",
      "label": "Custom title (overrides product title)"
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Fallback title",
      "default": "Select a piece in Theme Editor"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description (overrides product description)",
      "default": "<p>Worn and re-worn. The silhouette chosen most this season — the piece our clients return to, layer after layer, wardrobe after wardrobe. Not a trend. A foundation.</p>"
    },
    {
      "type": "header",
      "content": "Bundle contents"
    },
    {
      "type": "text",
      "id": "bundle_label",
      "label": "Bundle list heading",
      "default": "Included in this bundle"
    },
    {
      "type": "paragraph",
      "content": "Use the 'Add block' button below to list every piece inside the bundle."
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary CTA label",
      "default": "Add bundle to bag",
      "info": "Button adds the bestseller product to the cart."
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary link label",
      "default": "View full details"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Fallback link (used only when no product is chosen)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Reverse layout (text left, photo right)",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "bundle_item",
      "name": "Bundle item",
      "limit": 12,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Pick the piece included in the bundle."
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title (optional)",
          "info": "Overrides the product title in the list."
        },
        {
          "type": "text",
          "id": "price_label",
          "label": "Price label (optional)",
          "info": "Used only when no product is chosen, e.g. ‘—’ or ‘Included’."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bestseller",
      "blocks": [
        { "type": "bundle_item" },
        { "type": "bundle_item" },
        { "type": "bundle_item" }
      ]
    }
  ]
}
{% endschema %}
