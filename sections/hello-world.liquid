{% comment %}
  Home page — High-End Editorial Fashion layout
{% endcomment %}

{%- assign hero_has_image = false -%}
{%- if section.settings.hero_image -%}
  {%- assign hero_has_image = true -%}
{%- endif -%}

{%- liquid
  assign hero_product = all_products[section.settings.bestseller_product]
  assign hero_has_product = false
  if hero_product and hero_product != empty
    assign hero_has_product = true
  endif
  assign hero_variant    = hero_product.selected_or_first_available_variant
  assign hero_thumb      = section.settings.bestseller_thumb | default: hero_product.featured_image
-%}

{% comment %} ── HERO ─────────────────────────────────────────────────────── {% endcomment %}
<section class="editorial-hero full-width" aria-label="{{ 'home.hero.eyebrow' | t }}">
  <div class="editorial-hero__media" aria-hidden="true">
    {% if hero_has_image %}
      {{ section.settings.hero_image | image_url: width: 2800 | image_tag:
        loading: 'eager',
        class: 'editorial-hero__img',
        widths: '768, 1200, 1800, 2400',
        sizes: '100vw'
      }}
    {% else %}
      <div class="editorial-hero__img editorial-hero__img--placeholder"></div>
    {% endif %}
    <div class="editorial-hero__grain" aria-hidden="true"></div>
    <div class="editorial-hero__vignette" aria-hidden="true"></div>
  </div>

  <div class="editorial-hero__body">
    <p class="editorial-hero__season">{{ 'home.hero.season' | t }}</p>

    <h1 class="editorial-hero__headline">
      <span class="editorial-hero__headline-line1">{{ 'home.hero.headline_1' | t }}</span>
      <span class="editorial-hero__headline-line2">{{ 'home.hero.headline_2' | t }}</span>
    </h1>

    <a href="#shopify-section-bestseller" class="editorial-hero__cta" data-hero-cta>
      {{ 'home.hero.cta_shop_now' | t }}
    </a>
  </div>

  {% comment %} ── QUICK-BUY CARD — floating bestseller with ATC ─────── {% endcomment %}
  {%- if hero_has_product -%}
    <aside class="hero-quickbuy" aria-label="{{ section.settings.bestseller_eyebrow | default: 'Bestseller quick buy' }}">

      {%- comment -%} crosshair marker above the card {%- endcomment -%}
      <svg class="hero-quickbuy__mark" viewBox="0 0 40 40" aria-hidden="true">
        <line x1="0"  y1="20" x2="16" y2="20" stroke="currentColor" stroke-width="0.7"/>
        <line x1="24" y1="20" x2="40" y2="20" stroke="currentColor" stroke-width="0.7"/>
        <line x1="20" y1="0"  x2="20" y2="16" stroke="currentColor" stroke-width="0.7"/>
        <line x1="20" y1="24" x2="20" y2="40" stroke="currentColor" stroke-width="0.7"/>
        <circle cx="20" cy="20" r="3" stroke="currentColor" stroke-width="0.7" fill="none"/>
      </svg>

      <div class="hero-quickbuy__head">
        {% if hero_thumb %}
          <div class="hero-quickbuy__thumb">
            {{ hero_thumb | image_url: width: 280 | image_tag:
              loading: 'eager',
              widths: '140, 280, 420',
              sizes: '70px',
              alt: hero_product.title | escape
            }}
          </div>
        {% endif %}
        <div class="hero-quickbuy__meta">
          <p class="hero-quickbuy__eyebrow">
            <span class="hero-quickbuy__dot" aria-hidden="true"></span>
            {{ section.settings.bestseller_eyebrow | default: 'Bestseller · N°001' }}
          </p>
          <p class="hero-quickbuy__title">
            {%- if section.settings.bestseller_title != blank -%}
              {{ section.settings.bestseller_title }}
            {%- else -%}
              {{ hero_product.title | escape }}
            {%- endif -%}
          </p>
        </div>
      </div>

      <div class="hero-quickbuy__price-row">
        <p class="hero-quickbuy__price">
          {% if hero_product.compare_at_price_max > hero_product.price %}
            <s class="hero-quickbuy__price-was">{{ hero_product.compare_at_price_max | money }}</s>
          {% endif %}
          <span class="hero-quickbuy__price-now">{{ hero_product.price | money }}</span>
        </p>
        {% if hero_product.compare_at_price_max > hero_product.price %}
          {%- assign hero_save = hero_product.compare_at_price_max | minus: hero_product.price | times: 100 | divided_by: hero_product.compare_at_price_max -%}
          <span class="hero-quickbuy__save">− {{ hero_save }}%</span>
        {% endif %}
      </div>

      {% form 'product', hero_product, class: 'pd__form pd__form--atc hero-quickbuy__form' %}
        <input type="hidden" name="id" value="{{ hero_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button
          type="submit"
          class="hero-quickbuy__atc"
          data-atc-btn
          data-atc-label="{{ section.settings.bestseller_cta | default: 'Add to bag' }}"
          data-atc-adding="Adding"
          data-atc-added="Added"
          {% unless hero_variant.available %}disabled{% endunless %}
        >
          <span class="hero-quickbuy__atc-text pd__btn-text">
            {%- if hero_variant.available -%}
              {{ section.settings.bestseller_cta | default: 'Add to bag' }}
            {%- else -%}
              Sold out
            {%- endif -%}
          </span>
          <span class="hero-quickbuy__atc-arrow" aria-hidden="true">→</span>
        </button>
      {% endform %}

      <a href="{{ hero_product.url }}" class="hero-quickbuy__link">
        {{ section.settings.bestseller_secondary | default: 'View full details' }}
      </a>

    </aside>
  {%- endif -%}

  <p class="editorial-hero__scroll-hint" aria-hidden="true">scroll</p>

  {% comment %} ── TICKER — anchored to hero bottom edge ─────────── {% endcomment %}
  <div class="editorial-ticker" aria-hidden="true">
    <div class="editorial-ticker__track">
      <span>{{ 'home.ticker.text' | t }}</span>
      <span aria-hidden="true">{{ 'home.ticker.text' | t }}</span>
      <span aria-hidden="true">{{ 'home.ticker.text' | t }}</span>
      <span aria-hidden="true">{{ 'home.ticker.text' | t }}</span>
      <span aria-hidden="true">{{ 'home.ticker.text' | t }}</span>
      <span aria-hidden="true">{{ 'home.ticker.text' | t }}</span>
    </div>
  </div>

</section>

{% comment %} ── CATEGORIES GRID ───────────────────────────────────────────── {% endcomment %}
{% if section.blocks.size > 0 %}
  <section class="editorial-categories" aria-label="{{ 'home.categories.label' | t }}">
    {% for block in section.blocks %}
      <article
        class="editorial-cat{% if forloop.first %} editorial-cat--wide{% endif %}"
        {{ block.shopify_attributes }}
      >
        <div class="editorial-cat__media">
          {% if block.settings.image %}
            {{ block.settings.image | image_url: width: 1400 | image_tag:
              loading: 'lazy',
              class: 'editorial-cat__img',
              widths: '600, 900, 1200',
              sizes: '(max-width: 768px) 100vw, 50vw'
            }}
          {% else %}
            <div class="editorial-cat__img editorial-cat__img--placeholder"></div>
          {% endif %}
          <div class="editorial-cat__grain" aria-hidden="true"></div>
        </div>

        <div class="editorial-cat__info">
          {% if block.settings.eyebrow != blank %}
            <p class="editorial-cat__eyebrow">{{ block.settings.eyebrow | escape }}</p>
          {% endif %}
          <h2 class="editorial-cat__title">{{ block.settings.title | escape }}</h2>
          {% if block.settings.url != blank %}
            <a href="{{ block.settings.url }}" class="editorial-cat__link">
              {{ 'home.categories.shop_link' | t }}
            </a>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </section>
{% endif %}

{% stylesheet %}
  /* ── SHARED ─────────────────────────────────────────────────── */
  :root {
    --cream: #f0ede5;
    --ink: #1a1a18;
    --ink-muted: rgba(26, 26, 24, 0.55);
    --serif: var(--font-heading--family, "Playfair Display", Georgia, serif);
    --sans: var(--font-body--family, "Work Sans", system-ui, sans-serif);
  }

  /* ── HERO ───────────────────────────────────────────────────── */
  .editorial-hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: #0a0a09;
    color: var(--cream);
  }

  .editorial-hero__media {
    position: absolute;
    inset: 0;
  }

  .editorial-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    opacity: 0.88;
    filter: saturate(0.8) contrast(1.1);
  }

  .editorial-hero__img--placeholder {
    background: linear-gradient(170deg, #1a1a18 0%, #2d2d2a 45%, #1a1a18 100%);
  }

  /* grain layer */
  .editorial-hero__grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3CfeColorMatrix type='saturate' values='0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 200px;
    opacity: 0.45;
    mix-blend-mode: overlay;
  }

  /* gradient vignette */
  .editorial-hero__vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(10, 10, 9, 0.62) 0%, rgba(10, 10, 9, 0) 55%),
      linear-gradient(to top, rgba(10, 10, 9, 0.85) 0%, rgba(10, 10, 9, 0) 45%);
  }

  .editorial-hero__body {
    position: relative;
    z-index: 2;
    padding: max(9rem, 18vw) 4vw 8vw;
    max-width: 72rem;
  }

  .editorial-hero__season {
    font-family: var(--sans);
    font-size: 0.68rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(240, 237, 229, 0.72);
    margin-bottom: 2rem;
  }

  .editorial-hero__headline {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(3.2rem, 7.5vw, 9rem);
    line-height: 0.96;
    letter-spacing: -0.02em;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .editorial-hero__headline-line2 {
    padding-left: clamp(2rem, 8vw, 10rem);
    font-style: italic;
  }

  .editorial-hero__cta {
    display: inline-block;
    margin-top: 3.5rem;
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--cream);
    text-decoration: none;
    border-bottom: 1px solid rgba(240, 237, 229, 0.55);
    padding-bottom: 3px;
    transition: border-color 250ms ease, color 250ms ease;
  }

  .editorial-hero__cta:hover {
    border-color: var(--cream);
    color: #fff;
  }

  /* ═══════════════════════════════════════════════════════
     HERO QUICK-BUY CARD — floating bestseller
  ═══════════════════════════════════════════════════════ */
  .hero-quickbuy {
    position: absolute;
    z-index: 4;
    right: clamp(1.2rem, 3vw, 3rem);
    bottom: clamp(5.2rem, 10vh, 7.5rem);
    width: clamp(19rem, 26vw, 23rem);
    padding: 1.4rem 1.5rem 1.35rem;
    background: rgba(10, 10, 9, 0.58);
    backdrop-filter: blur(14px) saturate(1.1);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    border: 1px solid rgba(240, 237, 229, 0.14);
    color: var(--cream);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    opacity: 0;
    transform: translateY(14px);
    animation: hero-quickbuy-in 900ms cubic-bezier(0.23, 1, 0.32, 1) 450ms forwards;
    box-shadow:
      0 1px 0 rgba(240, 237, 229, 0.05) inset,
      0 40px 80px -40px rgba(0, 0, 0, 0.8);
  }

  @keyframes hero-quickbuy-in {
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-quickbuy__mark {
    position: absolute;
    top: -22px;
    left: -22px;
    width: 26px;
    height: 26px;
    color: rgba(240, 237, 229, 0.4);
  }

  .hero-quickbuy__head {
    display: grid;
    grid-template-columns: 62px 1fr;
    gap: 1rem;
    align-items: center;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid rgba(240, 237, 229, 0.1);
  }

  .hero-quickbuy__thumb {
    width: 62px;
    height: 82px;
    overflow: hidden;
    background: #14140f;
    border: 1px solid rgba(240, 237, 229, 0.08);
  }

  .hero-quickbuy__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.82) contrast(1.06);
  }

  .hero-quickbuy__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--sans);
    font-size: 0.54rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgba(240, 237, 229, 0.7);
    margin: 0 0 0.5rem;
  }

  .hero-quickbuy__dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #d4b878;
    box-shadow: 0 0 8px rgba(212, 184, 120, 0.8);
    animation: hero-quickbuy-pulse 2.4s ease-in-out infinite;
  }

  @keyframes hero-quickbuy-pulse {
    0%, 100% { opacity: 1;   transform: scale(1);   }
    50%      { opacity: 0.5; transform: scale(0.7); }
  }

  .hero-quickbuy__title {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 1.1rem;
    line-height: 1.15;
    color: var(--cream);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hero-quickbuy__price-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .hero-quickbuy__price {
    margin: 0;
    display: inline-flex;
    align-items: baseline;
    gap: 0.7rem;
    font-variant-numeric: tabular-nums;
  }

  .hero-quickbuy__price-was {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: rgba(240, 237, 229, 0.42);
    text-decoration: line-through;
  }

  .hero-quickbuy__price-now {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.2rem;
    color: var(--cream);
  }

  .hero-quickbuy__save {
    font-family: var(--sans);
    font-size: 0.55rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #d4b878;
    border: 1px solid rgba(212, 184, 120, 0.4);
    padding: 0.3rem 0.55rem;
  }

  .hero-quickbuy__form { margin: 0; padding: 0; }

  .hero-quickbuy__atc {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.95rem 1.1rem;
    background: var(--cream);
    color: #0a0a09;
    border: 1px solid var(--cream);
    border-radius: 0 !important;
    cursor: pointer;
    font-family: var(--sans);
    font-size: 0.68rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    position: relative;
    overflow: hidden;
    transition:
      background 260ms ease,
      color      260ms ease,
      gap        320ms ease;
  }

  .hero-quickbuy__atc:hover:not([disabled]) {
    background: transparent;
    color: var(--cream);
    gap: 1.4rem;
  }

  .hero-quickbuy__atc-arrow {
    transition: transform 420ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .hero-quickbuy__atc:hover:not([disabled]) .hero-quickbuy__atc-arrow {
    transform: translateX(4px);
  }

  .hero-quickbuy__atc[disabled] {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .hero-quickbuy__link {
    align-self: center;
    font-family: var(--sans);
    font-size: 0.55rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgba(240, 237, 229, 0.58);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: color 220ms ease, border-color 220ms ease;
  }

  .hero-quickbuy__link:hover {
    color: var(--cream);
    border-color: rgba(240, 237, 229, 0.4);
  }

  .editorial-hero__scroll-hint {
    position: absolute;
    z-index: 4;
    bottom: 5.2rem;
    right: 2.8rem;
    font-family: var(--sans);
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(240, 237, 229, 0.55);
    writing-mode: vertical-lr;
  }

  /* ── TICKER — anchored inside hero at its bottom edge ───────── */
  .editorial-ticker {
    position:        absolute;
    bottom:          0;
    left:            0;
    right:           0;
    z-index:         3;
    overflow:        hidden;
    white-space:     nowrap;
    padding:         0.95rem 0;
    /* frosted-glass strip over the hero photo */
    background:      rgba(10, 10, 9, 0.52);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-top:      1px solid rgba(240, 237, 229, 0.1);
  }

  .editorial-ticker__track {
    display:         inline-flex;
    gap:             4rem;
    /* seamless loop: duplicate spans cover two full widths */
    animation:       ticker-slide 32s linear infinite;
    font-family:     var(--sans);
    font-size:       0.62rem;
    letter-spacing:  0.28em;
    text-transform:  uppercase;
    /* cream text — visible on the dark hero */
    color:           rgba(240, 237, 229, 0.52);
  }

  .editorial-ticker__track span::before {
    content: '—';
    margin-right: 4rem;
    opacity: 0.3;
  }

  @keyframes ticker-slide {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ── CATEGORIES ─────────────────────────────────────────────── */
  .editorial-categories {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: auto;
    gap: 1.5px;
    background: rgba(26, 26, 24, 0.10);
  }

  .editorial-cat {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    background: var(--cream);
  }

  .editorial-cat--wide {
    grid-column: span 2;
  }

  .editorial-cat__media {
    position: relative;
    overflow: hidden;
  }

  .editorial-cat--wide .editorial-cat__media {
    aspect-ratio: 21 / 9;
  }

  .editorial-cat:not(.editorial-cat--wide) .editorial-cat__media {
    aspect-ratio: 4 / 5;
  }

  .editorial-cat__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.82) contrast(1.06);
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
    display: block;
  }

  .editorial-cat:hover .editorial-cat__img {
    transform: scale(1.04);
  }

  .editorial-cat__img--placeholder {
    background: linear-gradient(135deg, #1a1a18, #2d2d2a);
  }

  .editorial-cat__grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3CfeColorMatrix type='saturate' values='0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    background-size: 200px;
    mix-blend-mode: multiply;
    opacity: 0.5;
  }

  .editorial-cat__info {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.2rem, 3vw, 2.5rem);
    background: linear-gradient(to top, rgba(10, 10, 9, 0.7) 0%, rgba(10, 10, 9, 0) 50%);
    color: var(--cream);
  }

  .editorial-cat__eyebrow {
    font-family: var(--sans);
    font-size: 0.65rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(240, 237, 229, 0.72);
    margin-bottom: 0.5rem;
  }

  .editorial-cat__title {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 3.5vw, 3.2rem);
    font-weight: 300;
    line-height: 1.05;
  }

  .editorial-cat__link {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--sans);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--cream);
    text-decoration: none;
    border-bottom: 1px solid rgba(240, 237, 229, 0.5);
    padding-bottom: 2px;
    width: fit-content;
    transition: border-color 250ms ease;
  }

  .editorial-cat__link:hover {
    border-color: var(--cream);
  }

  @media (max-width: 767px) {
    /* Hero */
    .editorial-hero {
      min-height: 100svh;
    }

    .editorial-hero__body {
      padding: max(7rem, 20vw) 1.2rem 8vw;
    }

    .editorial-hero__season {
      font-size: 0.6rem;
      letter-spacing: 0.22em;
      margin-bottom: 1.2rem;
    }

    .editorial-hero__headline {
      font-size: clamp(2.6rem, 12vw, 4.5rem);
    }

    .editorial-hero__headline-line2 {
      padding-left: clamp(1rem, 6vw, 3rem);
    }

    .editorial-hero__cta {
      font-size: 0.65rem;
      letter-spacing: 0.2em;
      margin-top: 2.2rem;
    }

    .editorial-hero__scroll-hint {
      display: none;
    }

    /* Quick-buy card: stack full-width above ticker on mobile */
    .hero-quickbuy {
      left: 1rem;
      right: 1rem;
      bottom: 4.2rem;
      width: auto;
      padding: 1.1rem 1.1rem 1.05rem;
      gap: 0.85rem;
    }
    .hero-quickbuy__mark { display: none; }
    .hero-quickbuy__thumb { width: 54px; height: 72px; }
    .hero-quickbuy__head  { grid-template-columns: 54px 1fr; gap: 0.85rem; padding-bottom: 0.75rem; }
    .hero-quickbuy__title { font-size: 0.98rem; }
    .hero-quickbuy__atc   { padding: 0.85rem 1rem; font-size: 0.62rem; }
  }

  /* When the quick-buy card is on desktop, shift scroll-hint to the left */
  @media (min-width: 768px) {
    .editorial-hero:has(.hero-quickbuy) .editorial-hero__scroll-hint {
      right: auto;
      left: 2.8rem;
    }

    /* Category grid: 1 column */
    .editorial-categories {
      grid-template-columns: 1fr;
      gap: 1px;
    }

    .editorial-cat--wide {
      grid-column: span 1;
    }

    .editorial-cat--wide .editorial-cat__media,
    .editorial-cat:not(.editorial-cat--wide) .editorial-cat__media {
      aspect-ratio: 4 / 5;
    }

    .editorial-cat__info {
      padding: 1rem 1.1rem 1.4rem;
    }

    .editorial-cat__title {
      font-size: clamp(1.5rem, 7vw, 2.2rem);
    }

    .editorial-cat__link {
      font-size: 0.6rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var cta = document.querySelector('[data-hero-cta]');
    if (!cta) return;
    cta.addEventListener('click', function (e) {
      var id = cta.getAttribute('href');
      if (!id || id.charAt(0) !== '#') return;
      var target = document.querySelector(id);
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
{% endjavascript %}

